# ===================================================
# Fighters Token - Production Environment Variables
# ===================================================

# Database (PostgreSQL via Supabase or Neon)
# Example Supabase pooled connection string:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase direct connection string (for migrations / Prisma db push):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT & Session Secrets (generate with `openssl rand -hex 32`)
JWT_SECRET="generate_a_secure_random_64_character_hex_string_here_for_member_jwt"
ADMIN_SESSION_SECRET="generate_a_secure_random_64_character_hex_string_here_for_admin_session"

# Razorpay Payment Gateway
# Test keys start with rzp_test_, Live keys start with rzp_live_
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_samplekey123"
RAZORPAY_KEY_SECRET="sample_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="sample_webhook_secret_for_signature_verification"

# SMS / WhatsApp OTP Provider
# Options: "DEMO" | "MSG91" | "TWILIO"
# "DEMO" mode provides 123456 OTP and logs code to console / responses for seamless local & preview testing
OTP_PROVIDER="DEMO"

# MSG91 Configuration (if OTP_PROVIDER=MSG91)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Twilio Verify Configuration (if OTP_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SERVICE_SID=""

# Initial Admin Credentials (used by seed script: npm run db:seed)
ADMIN_INITIAL_EMAIL="admin@fighterstoken.com"
ADMIN_INITIAL_PASSWORD="AdminFighters@2026!"
